"about.title" = "About";
"about.appName" = "LabelProof";
"about.tagline" = "On-device packaging label verifier.";
"about.privacyTitle" = "Privacy";
"about.privacyBody" = "Core verification is entirely on-device: no account, no login, no analytics, no cloud OCR. Your data is stored locally by default. Optional backups use your own iCloud account or a Files location you explicitly choose — never a LabelProof-operated server.";
"about.howItWorksTitle" = "How it works";
"about.howItWorksBody" = "Create a golden label with the expected product name, weight, barcode, and required phrases. Scan a package, and LabelProof compares the recognized text and barcode against your golden label using deterministic rules — never AI guessing.";
"about.limitationsTitle" = "Limitations";
"about.limitationsBody" = "Recognition quality depends on lighting, focus, and print clarity. When recognition doesn't produce usable text or barcode data, LabelProof reports \"Insufficient data\" rather than guessing at a pass or fail.";
"about.openSourceTitle" = "Open source";
"about.openSourceBody" = "LabelProof is free and open-source. See the project README for the repository link and license.";
"about.deletionWarningTitle" = "Before you delete LabelProof";
"about.deletionWarningBody" = "Deleting LabelProof removes data stored locally on this iPhone. Export a backup or enable iCloud Backup if you want to restore your data later.";

