<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud Documents only — used for exactly one file, the current
	     Backup & Synchronization snapshot (see ICloudBackupStore). No
	     CloudKit database, no other iCloud service. Provisioning this
	     container identifier requires a paid Apple Developer Program team;
	     see docs/release/KNOWN_LIMITATIONS.md for the current state on a
	     Personal Team. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.labelproof.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.labelproof.app</string>
	</array>
</dict>
</plist>
