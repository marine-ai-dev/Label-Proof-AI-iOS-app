"about.title" = "Про застосунок";
"about.appName" = "LabelProof";
"about.tagline" = "Перевірка етикеток упаковки на пристрої.";
"about.privacyTitle" = "Приватність";
"about.privacyBody" = "Перевірка повністю відбувається на пристрої: без облікового запису, без входу, без аналітики, без хмарного розпізнавання. Ваші дані за замовчуванням зберігаються локально. Необов'язкові резервні копії використовують ваш власний обліковий запис iCloud або місце у Файлах, яке ви самі оберете — ніколи сервер LabelProof.";
"about.howItWorksTitle" = "Як це працює";
"about.howItWorksBody" = "Створіть еталонну етикетку з очікуваною назвою товару, вагою, штрих-кодом та обов'язковими фразами. Відскануйте упаковку — LabelProof порівняє розпізнаний текст і штрих-код з еталонною етикеткою за детермінованими правилами, без вгадувань ШІ.";
"about.limitationsTitle" = "Обмеження";
"about.limitationsBody" = "Якість розпізнавання залежить від освітлення, фокусу та чіткості друку. Якщо розпізнавання не дає придатних даних, LabelProof повідомляє «Недостатньо даних», а не вгадує результат.";
"about.openSourceTitle" = "Відкритий код";
"about.openSourceBody" = "LabelProof — безкоштовний застосунок із відкритим кодом. Посилання на репозиторій та ліцензію дивіться у README проєкту.";
"about.deletionWarningTitle" = "Перш ніж видалити LabelProof";
"about.deletionWarningBody" = "Видалення LabelProof видаляє дані, що зберігаються локально на цьому iPhone. Експортуйте резервну копію або увімкніть резервне копіювання в iCloud, якщо хочете відновити дані пізніше.";

